# Copy to .env for local compose deployment overrides.
#
# The defaults in docker-compose.yml are intentionally local-only. For any shared or
# internet-accessible deployment, replace all credentials before exposing ports.

S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
GRAFANA_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW__WEBSERVER__SECRET_KEY=replace-me-with-a-random-secret

# Required only for the live Alpaca producer profile.
ALPACA_API_KEY=
ALPACA_API_SECRET=
